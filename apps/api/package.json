{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@money-memory/shared": "workspace:*",
    "@prisma/client": "^6",
    "express": "^5",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^22",
    "@types/supertest": "^6",
    "prisma": "^6",
    "supertest": "^7",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
